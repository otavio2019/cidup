# Configure a senha local antes de iniciar o PostgreSQL pelo Docker Compose.
POSTGRES_PASSWORD=minhasenha123

# Use a URL apropriada para o backend executado no host ou dentro do Docker.
DATABASE_URL="postgresql://cidup:minhasenha123@localhost:5433/cidup?schema=public"

# Banco principal: Supabase. Copie em Supabase > Connect > Session pooler (porta 5432).
DOCKER_DATABASE_URL="postgresql://postgres.nxzclousmwuyurybpjae:SENHA_DO_BANCO@REGIAO.pooler.supabase.com:5432/postgres?schema=public"

# Backup: PostgreSQL local do Compose. Para usar, troque o valor acima por esta linha.
# DOCKER_DATABASE_URL="postgresql://cidup:minhasenha123@db:5432/cidup?schema=public"

# Gere localmente com: openssl rand -base64 32
AUTH_TOKEN_SECRET=
FRONTEND_ORIGINS=http://localhost:5173
ADMIN_USER_IDS=

# Supabase REST: a chave é secreta, use só no backend e nunca no frontend.
SUPABASE_URL=https://nxzclousmwuyurybpjae.supabase.co/rest/v1
SUPABASE_KEY=

# Opcional: necessário apenas quando o assistente de IA for utilizado.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

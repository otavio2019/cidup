# Configure a senha local antes de iniciar o PostgreSQL pelo Docker Compose.
POSTGRES_PASSWORD=replace-with-a-local-password

# Use a URL apropriada para o backend executado no host ou dentro do Docker.
DATABASE_URL="postgresql://cidup:replace-with-a-local-password@localhost:5433/cidup?schema=public"
DOCKER_DATABASE_URL="postgresql://cidup:replace-with-a-local-password@db:5432/cidup?schema=public"

# Gere localmente com: openssl rand -base64 32
AUTH_TOKEN_SECRET=
FRONTEND_ORIGINS=http://localhost:5173
ADMIN_USER_IDS=

# Opcional: necessário apenas quando o assistente de IA for utilizado.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

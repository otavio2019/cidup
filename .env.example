# Senha usada pelo serviço PostgreSQL local.
POSTGRES_PASSWORD=cidup_local_dev_password

# URL usada quando a API roda no host.
DATABASE_URL="postgresql://cidup:cidup_local_dev_password@localhost:5433/cidup?schema=public"

# URL usada quando a API roda dentro da rede Docker Compose.
DOCKER_DATABASE_URL="postgresql://cidup:cidup_local_dev_password@db:5432/cidup?schema=public"

# URL direta usada pelo Prisma Migrate para migrações.
DIRECT_URL="postgresql://cidup:cidup_local_dev_password@db:5432/cidup?schema=public"

# Segredo apenas para desenvolvimento local; troque em qualquer ambiente real.
AUTH_TOKEN_SECRET=cidup-local-development-secret-change-before-production-32-bytes
FRONTEND_ORIGINS=http://localhost:5173
ADMIN_USER_IDS=
# URL usada pelo navegador para chamar a API. Em produção, use uma URL HTTPS pública.
VITE_API_URL=http://localhost:3000

# Integrações opcionais.
SUPABASE_URL=
SUPABASE_KEY=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

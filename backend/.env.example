# URL usada quando o backend roda diretamente no host.
DATABASE_URL="postgresql://cidup:cidup_local_dev_password@localhost:5433/cidup?schema=public"

# URL direta usada pelo Prisma Migrate para migrações.
DIRECT_URL="postgresql://cidup:cidup_local_dev_password@localhost:5433/cidup?schema=public"

# Segredo apenas para desenvolvimento local; troque em qualquer ambiente real.
AUTH_TOKEN_SECRET=cidup-local-development-secret-change-before-production-32-bytes
FRONTEND_ORIGINS=http://localhost:5173
# Conta única do responsável, usada pelo comando npm run seed:responsavel.
RESPONSAVEL_NAME=Responsável CIDUP
RESPONSAVEL_EMAIL=responsavel@cidup.local
RESPONSAVEL_PHONE=(83) 99999-9999
RESPONSAVEL_PASSWORD=troque-esta-senha-local
RESPONSAVEL_ORGAO_ID=1

# Opcional: assistente de IA.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Local: URL usada quando o backend roda diretamente no host.
# Produção: substitua pela URL de runtime do Supabase.
DATABASE_URL="postgresql://cidup:cidup_local_dev_password@localhost:5433/cidup?schema=public"

# Local: URL direta usada pelo Prisma Migrate para migrações.
# Produção: use a conexão direta ou Session Pooler indicada pelo Supabase.
DIRECT_URL="postgresql://cidup:cidup_local_dev_password@localhost:5433/cidup?schema=public"

# Exemplo Supabase para redes IPv4: use o Transaction Pooler em runtime e o
# Session Pooler para migrações. Substitua [YOUR-PASSWORD] localmente.
# DATABASE_URL="postgresql://postgres.ccoqaxglvhucrqobdhme:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.ccoqaxglvhucrqobdhme:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Segredo apenas para desenvolvimento local; troque em qualquer ambiente real.
AUTH_TOKEN_SECRET=cidup-local-development-secret-change-before-production-32-bytes
# Produção: URL pública do frontend na Vercel.
FRONTEND_ORIGINS=http://localhost:5173
# Conta única do responsável, usada pelo comando npm run seed:responsavel.
RESPONSAVEL_NAME=Responsável CIDUP
RESPONSAVEL_EMAIL=responsavel@cidup.local
RESPONSAVEL_PHONE=(83) 99999-9999
RESPONSAVEL_PASSWORD=troque-esta-senha-local
RESPONSAVEL_ORGAO_ID=1

# Opcional: assistente de IA.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

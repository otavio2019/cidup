{
  // Consulte https://aka.ms/tsconfig para saber mais sobre este arquivo.
  "compilerOptions": {
    // Organização dos arquivos
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Configurações do ambiente
    // Consulte também https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": [],
    // Para Node.js:
    // "lib": ["esnext"],
    // "types": ["node"],
    // e execute npm install -D @types/node

    // Outras saídas
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Opções mais rigorosas de verificação de tipos
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Opções de estilo
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Opções recomendadas
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  }
}

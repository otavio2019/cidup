generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model denuncia {
  id_denuncia   Int         @id @default(autoincrement())
  titulo        String      @db.VarChar(200)
  descricao     String
  tipo          String      @db.VarChar(100)
  status        String      @db.VarChar(50)
  data_registro DateTime    @default(dbgenerated("CURRENT_DATE")) @db.Date
  endereco      String
  latitude      Float
  longitude     Float
  id_usuario    Int
  id_orgao      Int
  orgao         orgao       @relation(fields: [id_orgao], references: [id_orgao], onDelete: NoAction, onUpdate: NoAction)
  orgaos_extras orgao[]     @relation("DenunciaOrgaosExtras")
  usuario        usuario     @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  historico     historico[]
}

model historico {
  id_historico Int      @id @default(autoincrement())
  descricao    String
  foto         String
  observacao   String
  id_usuario   Int
  id_denuncia  Int
  denuncia     denuncia @relation(fields: [id_denuncia], references: [id_denuncia], onDelete: NoAction, onUpdate: NoAction)
  usuario      usuario  @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
}

model orgao {
  id_orgao  Int        @id @default(autoincrement())
  nome      String     @db.VarChar(150)
  email     String     @unique @db.VarChar(255)
  telefone  String     @unique @db.VarChar(20)
  descricao String
  denuncia  denuncia[]
  denuncias_extras denuncia[] @relation("DenunciaOrgaosExtras")
}

model usuario {
  id_usuario Int         @id @default(autoincrement())
  nome       String      @db.VarChar(150)
  email      String      @unique @db.VarChar(255)
  telefone   String?     @unique @db.VarChar(20)
  senha      String      @db.VarChar(255)
  denuncia   denuncia[]
  historico  historico[]
}

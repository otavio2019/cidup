generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Registro de uma ocorrência cidadã, incluindo localização, foto, órgão e status.
model denuncia {
  id_denuncia   Int         @id @default(autoincrement())
  titulo        String      @db.VarChar(200)
  descricao     String
  tipo          String      @db.VarChar(100)
  categorias    String[]    @default([])
  status        String      @db.VarChar(50)
  data_registro DateTime    @default(dbgenerated("CURRENT_DATE")) @db.Date
  atualizada_em DateTime    @default(now()) @updatedAt @db.Timestamp(3)
  endereco      String
  latitude      Float
  longitude     Float
  foto          String?     @db.Text
  id_usuario    Int
  id_orgao      Int
  orgao         orgao       @relation(fields: [id_orgao], references: [id_orgao], onDelete: NoAction, onUpdate: NoAction)
  orgaos_extras orgao[]     @relation("DenunciaOrgaosExtras")
  usuario       usuario     @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  historico     historico[]
}

/// Atualização ou observação de atendimento vinculada a uma denúncia.
model historico {
  id_historico   Int          @id @default(autoincrement())
  descricao      String
  foto           String
  observacao     String
  data_criacao   DateTime     @default(now()) @db.Timestamp(3)
  id_usuario     Int?
  id_responsavel Int?
  id_denuncia    Int
  denuncia       denuncia     @relation(fields: [id_denuncia], references: [id_denuncia], onDelete: NoAction, onUpdate: NoAction)
  usuario        usuario?     @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  responsavel    responsavel? @relation(fields: [id_responsavel], references: [id_responsavel], onDelete: NoAction, onUpdate: NoAction)
}

/// Órgão público que recebe e atende denúncias.
model orgao {
  id_orgao         Int           @id @default(autoincrement())
  nome             String        @db.VarChar(150)
  email            String        @unique @db.VarChar(255)
  telefone         String        @unique @db.VarChar(20)
  descricao        String
  denuncia         denuncia[]
  denuncias_extras denuncia[]    @relation("DenunciaOrgaosExtras")
  responsaveis     responsavel[]
}

/// Conta administrativa vinculada a um órgão.
model responsavel {
  id_responsavel Int         @id @default(autoincrement())
  nome           String      @db.VarChar(150)
  email          String      @unique @db.VarChar(255)
  telefone       String      @db.VarChar(20)
  senha          String      @db.VarChar(255)
  id_orgao       Int
  orgao          orgao       @relation(fields: [id_orgao], references: [id_orgao], onDelete: NoAction, onUpdate: NoAction)
  historicos     historico[]
}

/// Conta do cidadão que registra e acompanha denúncias.
model usuario {
  id_usuario Int         @id @default(autoincrement())
  cpf        String?     @unique @db.VarChar(11)
  nome       String      @db.VarChar(150)
  email      String      @unique @db.VarChar(255)
  telefone   String?     @unique @db.VarChar(20)
  cep        String?     @db.VarChar(8)
  foto       String?     @db.Text
  senha      String      @db.VarChar(255)
  denuncia   denuncia[]
  historico  historico[]
}
